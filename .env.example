# Copiar este archivo a .env y completar con valores reales.
# .env NUNCA debe subirse al repositorio (ver .gitignore).

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgres://bodega_user:bodega_pass@localhost:5432/bodega_db

# Monitoreo de errores (opcional). Crea una cuenta gratis en sentry.io,
# crea un proyecto tipo "Django" y pega aqui el DSN que te entrega.
# Si se deja vacio, el sistema funciona igual pero sin avisar de errores.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
